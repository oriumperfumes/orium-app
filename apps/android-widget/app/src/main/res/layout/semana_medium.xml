        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/l4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#73FFFFFF" android:textSize="10sp" android:textStyle="bold" />
