        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/l5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#73FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/d5" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/circle_empty" android:gravity="center" android:textColor="#66FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/c5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#FFD599" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/l6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#73FFFFFF" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/d6" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/circle_empty" android:gravity="center" android:textColor="#66FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/c6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#FFD599" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
